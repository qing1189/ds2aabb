# ===== DS Gateway 配置示例 =====

# 服务端口（默认 3000）
PORT=3000

# ===== 管理面板密码（独立于 API Key）=====
# 用于保护 /admin 管理面板，不设则面板无需密码
ADMIN_PASSWORD=your-admin-password

# ===== API Key（用于模型调用接口鉴权）=====
# 支持多个 Key，逗号分隔。不设则接口无需鉴权
# 也可以通过管理面板在线添加/删除
API_KEYS=key1,key2,key3
# 兼容旧配置（单个 key）
# API_KEY=your-single-key

# ===== 令牌配置（至少配置一种方式）=====

# 方式一：单个令牌
# DS_TOKEN=your_deepseek_token_here

# 方式二：多个令牌（逗号分隔）
DS_TOKENS=token1,token2,token3

# ===== 账号配置（可选，也可通过管理面板在线添加）=====

# 账号密码对（逗号分隔，格式: account:password）
# account 支持邮箱或手机号
# DS_ACCOUNTS=user1@example.com:password1,13800138000:password2

# 扩展格式（关联已有令牌，格式: account:password:token_prefix）
# DS_ACCOUNTS_EXTENDED=user1@example.com:password1:abc123def456

# ===== 代理配置（可选，也可通过管理面板在线配置）=====

# 全局出站代理（用于所有 API 请求）
# HTTPS_PROXY=http://127.0.0.1:7890

# 登录代理通过管理面板配置（仅用于添加账号时绕过 WAF）
